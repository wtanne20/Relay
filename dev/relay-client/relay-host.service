# Relay host — exposes this machine's files + shell to the Relay brain.
# A *user* service: runs when you log in, no root needed.
[Unit]
Description=Relay host (exposes this machine's files to the Relay brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/relay host \
  --bind 0.0.0.0:8766 \
  --root %h \
  --name relay-client \
  --config %h/.relay-client/config.toml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
