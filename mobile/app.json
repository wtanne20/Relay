{
  "expo": {
    "name": "Relay",
    "slug": "relay",
    "scheme": "relay",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.relay",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.example.relay",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        { "action": "SEND", "category": ["DEFAULT"], "data": [{ "mimeType": "*/*" }] },
        { "action": "SEND_MULTIPLE", "category": ["DEFAULT"], "data": [{ "mimeType": "*/*" }] }
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Relay lets you attach photos to a chat so the model can look at them.",
          "cameraPermission": "Relay lets you take a photo to attach to a chat.",
          "microphonePermission": "Relay listens in voice mode, so you can talk to the agent hands-free. Speech is turned into text on this phone."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Relay uses the camera to scan the pairing QR code shown on your PC.",
          "microphonePermission": "Relay listens in voice mode, so you can talk to the agent hands-free. Speech is turned into text on this phone.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8DD7A8",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Relay listens in voice mode, so you can talk to the agent hands-free. Speech is turned into text on this phone.",
          "speechRecognitionPermission": "Relay turns what you say in voice mode into text for the agent."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {}
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
