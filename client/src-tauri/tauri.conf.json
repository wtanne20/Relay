{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay Client",
  "mainBinaryName": "relay-client",
  "version": "1.0.6",
  "identifier": "com.example.relay.client",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relay Client",
        "width": 480,
        "height": 640,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#141414",
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "../../desktop/src-tauri/icons/32x32.png",
      "../../desktop/src-tauri/icons/128x128.png",
      "../../desktop/src-tauri/icons/128x128@2x.png",
      "../../desktop/src-tauri/icons/icon.png",
      "../../desktop/src-tauri/icons/icon.ico"
    ]
  }
}
