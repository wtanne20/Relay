{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "mainBinaryName": "relay-desktop",
  "version": "1.0.0",
  "identifier": "com.example.relay.desktop",
  "build": {
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../mobile/dist",
    "beforeBuildCommand": {
      "script": "npm run export:web",
      "cwd": "../../mobile"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Relay",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#141414",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
